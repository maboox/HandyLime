<Window x:Class="HandyLime.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="HandyLime" Width="1160" Height="800" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragged" Icon="Assets/handylime.ico">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}"><Grid Margin="20,30,20,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><ContentControl x:Name="BrandMark" Width="38" Height="38" Margin="0,0,10,0"/><TextBlock Text="HandyLime" Foreground="{DynamicResource SidebarInk}" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="A little less busywork." Foreground="{DynamicResource SidebarMuted}" Margin="0,13,0,28" FontSize="12"/></StackPanel>
   <StackPanel Grid.Row="1"><Button x:Name="ConvertNav" Style="{StaticResource Nav}" Content="↗    Convert" Click="ConvertTab"/><Button x:Name="ToolsNav" Style="{StaticResource Nav}" Content="◇    File tools" Click="ToolsTab"/><Button x:Name="ActivityNav" Style="{StaticResource Nav}" Content="Activity" Click="ActivityTab"/><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="Settings" Click="SettingsTab"/></StackPanel>
   <Border Grid.Row="3" Background="{DynamicResource Sidebar}" CornerRadius="12" Padding="15"><StackPanel><TextBlock Text="●  LOCAL BY DESIGN" Foreground="{DynamicResource Accent}" FontSize="10" FontWeight="Bold"/><TextBlock Text="Your files stay with you.&#10;No accounts. No uploads." Foreground="{DynamicResource SidebarMuted}" FontSize="12" Margin="0,10,0,0"/><TextBlock Text="HandyLime 0.3.0" Foreground="{DynamicResource SidebarMuted}" FontSize="10" Margin="0,18,0,0"/></StackPanel></Border>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="32,24,32,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22"><Border DockPanel.Dock="Right" Background="{DynamicResource Subtle}" CornerRadius="14" Padding="12,6"><TextBlock x:Name="WheelStatus" Text="●  Drag wheel on" Foreground="{DynamicResource Ink}" FontSize="11"/></Border><TextBlock Text="YOUR EVERYDAY FILE WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
   <Grid Grid.Row="1" x:Name="Workspace"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,21"><TextBlock x:Name="Heading" Text="New format. Same flow." FontSize="33" FontWeight="SemiBold"/><TextBlock x:Name="Subheading" Text="Drop your files, pick a format, and get back to what matters." Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Drop something here" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Images, media, PDFs, documents &amp; more" Foreground="{DynamicResource Muted}" Margin="0,7,0,15"/><StackPanel Orientation="Horizontal"><Button x:Name="AddFilesButton" Content="Add files" Click="AddFiles" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button Content="Add folder" Click="AddFolder"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Width="190" VerticalAlignment="Center"><TextBlock Text="TRY IT FROM EXPLORER" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="Bold"/><TextBlock Text="Drag a file + tap Shift" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Drop on a format in the wheel.&#10;Alt for tools · Ctrl for actions" Foreground="{DynamicResource Muted}" FontSize="12"/><Button Content="Open wheel" Click="OpenWheel" Padding="10,6" Margin="0,12,0,0" HorizontalAlignment="Left"/></StackPanel></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="Clear" Click="ClearFiles" Padding="9,4" FontSize="11"/><TextBlock x:Name="FileCount" Text="YOUR FILES  /  0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
      <Grid Grid.Row="1" Margin="0,14,0,8"><TextBlock x:Name="EmptyState" Text="A clean slate.&#10;&#10;Add a file to see what you can do with it." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="230"/><ListBox x:Name="FileList" BorderThickness="0" Background="Transparent" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource Subtle}" Width="34" Height="38" CornerRadius="7" VerticalAlignment="Top"><TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      <StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="MoveUpButton" Content="Up" Click="MoveUp" Padding="10,5" ToolTip="Move selected file up"/><Button x:Name="MoveDownButton" Content="Down" Click="MoveDown" Padding="10,5" Margin="5,0" ToolTip="Move selected file down"/><Button Content="Remove" Click="RemoveFile" Padding="10,5" FontSize="11"/><Button Content="Actions" Click="ActionsClick" Padding="10,5" FontSize="11" Margin="5,0,0,0"/></StackPanel>
     </Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="OptionsTitle" Text="MAKE IT YOURS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="OptionsHint" Text="Available formats appear here." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><TextBox x:Name="OptionSearch" Tag="Find a format or tool" TextChanged="FilterOptions" ToolTip="Filter formats or tools by name" Padding="8,6" Margin="0,0,0,12" AutomationProperties.Name="Filter formats or tools"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="OptionsPanel"/></ScrollViewer><StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="DestinationLabel" Text="Save beside the original" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/><Button x:Name="RunButton" Content="Choose a format" Style="{StaticResource Primary}" Click="RunSelected" IsEnabled="False"/></StackPanel></Grid></Border>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="OtherPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OtherContent"/></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,13,0,0"><DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Click="CancelJobs" Padding="10,4" Visibility="Collapsed"/><TextBlock x:Name="StatusText" Text="Ready when you are. Originals are always preserved by conversions." FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/><ProgressBar x:Name="BusyBar" Width="70" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0" Foreground="{DynamicResource Accent}"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>

